<Window x:Class="FileWatcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileWatcher"
        mc:Ignorable="d"
        Title="File Watcher" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="File Path" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox Grid.Row="1" x:Name="PathTextBox" IsReadOnly="True"  Margin="0,0,0,15"/>
        <TextBox Grid.Row="2" x:Name="ContentTextBox" AcceptsReturn="True" TextWrapping="Wrap"/>
        <Button Grid.Row="3" Content="Save" Width="100" Height="35" HorizontalAlignment="Center" Click="SaveButton_Click" FontWeight="ExtraBold"  Background="LightGreen" Margin="0,15,0,0"/>

    </Grid>
</Window>
